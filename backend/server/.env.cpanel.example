# cPanel Node.js App environment variables
NODE_ENV=production
PORT=8080
APP_NAME=OPAS CRM

# MongoDB Atlas connection string
# Existing OPAS users are in the /test database. Do not change /test to /opas_crm unless data is migrated.
MONGO_URI=mongodb+srv://CRM:YOUR_MONGODB_PASSWORD@cluster0.sbrs6mi.mongodb.net/test?retryWrites=true&w=majority&appName=Cluster0
DB_CONNECT_TIMEOUT_MS=30000

# Frontend domains allowed by CORS and Socket.IO
CLIENT_ORIGIN=https://opasbizz.co.in
CLIENT_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,https://opasbizz.co.in,https://www.opasbizz.co.in,https://opasbizz.in,https://www.opasbizz.in

# Public backend URL shown in health checks/logs
API_PUBLIC_URL=https://api.opasbizz.co.in

# JWT secrets: replace with the existing live secrets or long random strings before upload
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Required for cross-domain HTTPS cookies in production
COOKIE_SECURE=true
BCRYPT_ROUNDS=12

# Optional SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@opasbizz.co.in

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10